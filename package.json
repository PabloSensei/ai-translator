{
  "name": "ai-translator",
  "version": "2.1.0",
  "description": "Desktop translator powered by Google Gemini, Anthropic Claude or OpenRouter, with 30+ languages and multiple translation styles",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --linux --win",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.ai.translator",
    "productName": "AI Translator",
    "artifactName": "AI-Translator-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "theme-init.js",
      "utils.js",
      "languages.js",
      "lib/**/*",
      "index.html",
      "styles.css",
      "assets/**/*",
      "!assets/screenshot*",
      "!assets/source/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "PabloSensei",
        "repo": "ai-translator"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "AI-Translator-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "PabloSensei"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true
    }
  },
  "keywords": [
    "translator",
    "gemini",
    "ai",
    "electron",
    "desktop",
    "google-ai",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0"
  },
  "allowScripts": {
    "electron@44.8.0": true
  }
}
