{
  "name": "ai-translator",
  "version": "1.1.0",
  "description": "Desktop translator powered by Google Gemini, Anthropic Claude or OpenRouter, with 30+ languages and multiple translation styles",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --linux --win",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.ai.translator",
    "productName": "AI Translator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "theme-init.js",
      "utils.js",
      "languages.js",
      "lib/**/*",
      "index.html",
      "styles.css",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "PabloSensei"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    }
  },
  "keywords": [
    "translator",
    "gemini",
    "ai",
    "electron",
    "desktop",
    "google-ai",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1"
  },
  "allowScripts": {
    "electron@44.3.0": true
  }
}
